{
  "name": "litto",
  "description": "LITTO（里头）—— 好戏，都在里头。面向影视与短剧创作的 AI 工作台。",
  "author": "LITTO contributors",
  "license": "MIT",
  "homepage": "https://github.com/laixi969-coder/LITTO#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laixi969-coder/LITTO.git"
  },
  "bugs": {
    "url": "https://github.com/laixi969-coder/LITTO/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "@vue-flow/core@1.48.2": "patches/vueFlowCore.patch"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/nodes/*",
    "packages/tools/*",
    "packages/teams/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@toonflow/web' --filter '@toonflow/server' dev",
    "dev:web": "bun run --filter '@toonflow/web' dev",
    "dev:server": "bun run --filter '@toonflow/server' dev",
    "dev:desktop": "bun run --filter '@toonflow/desktop' dev",
    "dev:plugins": "NODE_ENV=dev bun run --filter './packages/tools/*' --filter './packages/nodes/*' --filter './packages/teams/*' build",
    "dev:updateServer": "bun run --filter '@toonflow/updateServer' dev",
    "start:updateServer": "bun run --filter '@toonflow/updateServer' start",
    "publish:update": "bun run apps/updateServer/scripts/publish.ts",
    "start:server": "bun run --cwd apps/server start",
    "build:server": "bun apps/server/scripts/buildStandalone.ts",
    "build": "bun run build:tools && bun run --filter '@toonflow/web' --filter '@toonflow/server' build",
    "build:nodes": "bun -e \"import { rmSync } from '@toonflow/file'; import { resolve } from 'node:path'; rmSync(resolve('build/nodes'), { recursive: true, force: true });\" && NODE_ENV=production bun run --filter './packages/nodes/*' build",
    "build:desktop": "bun run --filter '@toonflow/desktop' build",
    "build:mcp": "bun run --filter '@toonflow/mcp' build",
    "build:teams": "NODE_ENV=production bun run --filter './packages/teams/*' build",
    "package:desktop": "bun run --filter '@toonflow/desktop' package",
    "release:desktop": "bun run apps/desktop/scripts/release.ts",
    "typecheck": "bun run --filter '@toonflow/*' typecheck",
    "build:tools": "bun -e \"import { rmSync } from '@toonflow/file'; import { resolve } from 'node:path'; rmSync(resolve('build/tools'), { recursive: true, force: true });\" && NODE_ENV=production bun run --filter './packages/tools/*' build"
  },
  "devDependencies": {
    "@toonflow/file": "*",
    "@types/bun": "^1.4.2",
    "@types/postcss-pxtorem": "^6.1.0",
    "postcss": "^8.5.28",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "^7.0.2"
  }
}
