 "profile": {
  "definition": "深棕油画与赭石暖肤构筑历史的重量，暖棕墨黑的阴影中藏着尊严与忍耐，克制比爆发更有力量。",
  "lighting": "侧光为主，油画式明暗对比；自然光优先，阴影偏暖棕而非冷黑；高光偏琥珀金。",
  "framing": "长镜头静观是签名，让观众与人物共同承受；自然画框暗示囚禁与隔离；群像如历史画卷。",
  "grading": "整体暖棕赭石调，饱和偏低但厚重；类似古典油画的色彩层次，不追求鲜亮。",
  "avoid": "高饱和亮色、青橙调色、快速剪辑、煽情配乐与镜头、浪漫化苦难"
 }
